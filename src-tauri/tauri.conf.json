{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bootleg",
  "version": "0.3.1",
  "identifier": "org.skurda.bootleg",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "node scripts/build.mjs", "beforeDevCommand": "node scripts/build.mjs" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "shortDescription": "Music player with stems, notes and live visualizers",
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 audio", "description": "MP3 audio", "mimeType": "audio/mpeg", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["flac"], "name": "FLAC audio", "description": "FLAC audio", "mimeType": "audio/flac", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["m4a", "aac"], "name": "MPEG-4 audio", "description": "MPEG-4 audio", "mimeType": "audio/mp4", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["ogg", "opus"], "name": "Ogg audio", "description": "Ogg audio", "mimeType": "audio/ogg", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["wav"], "name": "WAV audio", "description": "WAV audio", "mimeType": "audio/wav", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["aif", "aiff"], "name": "AIFF audio", "description": "AIFF audio", "mimeType": "audio/aiff", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["caf"], "name": "Core Audio audio", "description": "Core Audio audio", "mimeType": "audio/x-caf", "role": "Viewer", "rank": "Alternate" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
