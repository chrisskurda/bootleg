{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bootleg",
  "version": "0.1.0",
  "identifier": "org.skurda.bootleg",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "node scripts/build.mjs", "beforeDevCommand": "node scripts/build.mjs" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "bootleg", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600, "dragDropEnabled": true }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "shortDescription": "Music player with stems, notes and live visualizers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
