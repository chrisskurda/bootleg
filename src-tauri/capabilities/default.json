{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The player window: pick folders/files, read the library the user chose, save exports. Source plugins (e.g. Subsonic) talk to servers the user configured, so HTTP(S) is allowed.",
  "windows": [
    "main",
    "screen"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}