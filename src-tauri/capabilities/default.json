{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The player window: pick folders/files, read the library the user chose, save exports.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open", "dialog:allow-save",
    "fs:allow-read-dir", "fs:allow-stat", "fs:allow-write-text-file", "fs:allow-read-text-file"
  ]
}
